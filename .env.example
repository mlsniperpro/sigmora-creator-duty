# Local demo defaults to deterministic, fully reproducible providers.
NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080
STORE_PROVIDER=memory
MODEL_PROVIDER=deterministic
MEDIA_PROVIDER=deterministic
PUBLISH_PROVIDER=deterministic
ALLOW_DEMO_TRIGGER=true

# Production: Gemini 3.7 Flash through the official Google GenAI SDK on Vertex AI.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_MEDIA_LOCATION=us-central1
GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_KEY=

# Firestore and Pub/Sub.
FIRESTORE_DATABASE_ID=(default)
PUBSUB_TOPIC=creator-duty-events
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT_EMAIL=
ALLOW_UNAUTHENTICATED_PUBSUB=false

# Restrict judge/demo mutations. Leave blank only for local development.
DEMO_API_KEY=
DEMO_CREATOR_ID=demo_creator
DEMO_DAILY_START_LIMIT=12
DEMO_START_COOLDOWN_SECONDS=15
MAX_MODEL_SPEND_USD=5

# Optional scoped Sigmora boundary. The model never receives this credential.
SIGMORA_API_BASE_URL=
SIGMORA_API_TOKEN=

# Optional additional-model integrations. Disabled until exercised and evidenced.
ENABLE_VEO=false
VEO_MODEL=veo-3.1-generate-preview
ENABLE_LYRIA=false
LYRIA_MODEL=lyria-3-clip-preview
ENABLE_GEMMA=false
GEMMA_MODEL=
ARTIFACT_BUCKET=
